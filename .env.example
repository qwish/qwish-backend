PORT=8080
APP_ENV=development

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Amazon S3 (dedicated bucket for publicly readable media)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=qwish-media-your-unique-suffix
# Optional: defaults to the bucket's regional HTTPS object endpoint.
S3_PUBLIC_URL=
# The AWS SDK also supports shared profiles and temporary credentials.
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_SESSION_TOKEN=

# Resend
RESEND_API_KEY=re_...

# Cron protection
CRON_SECRET=your-cron-secret
ALLOWED_ORIGINS=http://localhost:3000

# Required in production for push notifications. JSON must be on one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_MODE=off
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
TURNSTILE_SECRET=
ANTHROPIC_API_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000
# Development-only recruiter dashboard test login. Leave blank in production.
RECRUITER_TEST_LOGIN_SECRET=
RECRUITER_TEST_LOGIN_EMAIL=

# App store review login. Set both or neither; unlike the recruiter test login
# above, this one is meant to be set in production, because review runs against
# prod. The address must already exist as a seeded learner, the code must be
# exactly 6 digits (the app's OTP field takes nothing else), and the account
# cannot enrol a passkey.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_OTP=
