meta {
  name: POST /upload/image
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/upload/image
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Send multipart/form-data with file (JPEG, PNG, or WebP, max 5 MB) and optional prefix.
  The backend writes to Amazon S3 and returns a permanent public S3 image URL.
}
