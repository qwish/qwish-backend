meta {
  name: POST /upload/presign
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/upload/presign
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "content_type": "image/jpeg",
    "prefix": "quiz-images",
    "size": 482133
  }
}

docs {
  Returns a five-minute Amazon S3 PUT URL and a permanent public S3 image URL.
  PUT the image bytes to upload_url with Content-Type: image/jpeg, then display public_url.
  Browser uploads require the frontend origin in the S3 bucket CORS configuration.
}
