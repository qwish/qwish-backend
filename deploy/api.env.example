# Compose reads this file as raw KEY=value pairs. Do not surround values with quotes.
PORT=8080
APP_ENV=production
DATABASE_URL=postgresql://postgres.your-project:password@your-session-pooler:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me
AWS_REGION=ap-south-1
S3_BUCKET_NAME=qwish-media-your-unique-suffix
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_SESSION_TOKEN=
AWS_EC2_METADATA_DISABLED=true
RESEND_API_KEY=replace-me
CRON_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://app.qwish.in,https://superadmin.qwish.in,https://institute.qwish.in,https://teacher.qwish.in,https://qwish.in
FCM_PROJECT_ID=replace-me
FCM_SERVICE_ACCOUNT_JSON={"replace":"with the complete service account JSON on one line"}
PLAY_INTEGRITY_MODE=off
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
TURNSTILE_SECRET=
ANTHROPIC_API_KEY=
WEBAUTHN_RP_ID=qwish.in
# Add the current Android origin from the existing production configuration.
WEBAUTHN_RP_ORIGINS=https://app.qwish.in,https://qwish.in,https://superadmin.qwish.in
WEBAUTHN_RP_DISPLAY_NAME=Qwish
APP_URL=https://app.qwish.in
SUPER_ADMIN_URL=https://superadmin.qwish.in
INSTITUTE_DASHBOARD_URL=https://institute.qwish.in
TEACHER_PANEL_URL=https://teacher.qwish.in
BRAND_URL=https://qwish.in
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_OTP=

# Per-replica API + worker connection budgets (18 by default).
DB_MIN_CONNS=2
DB_MAX_CONNS=10
WORKER_DB_MAX_CONNS=8
# Direct or session-pooler URL to the same DB; LISTEN cannot use transaction pooling.
WORKER_DATABASE_URL=
MIGRATE_ONLY=false
BACKFILL_RATINGS=false
